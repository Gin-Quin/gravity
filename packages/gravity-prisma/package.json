{
	"name": "@digitak/gravity-prisma",
	"version": "0.9.69",
	"repository": "https://github.com/Gin-Quin/gravity",
	"author": "Gin Quin",
	"license": "GNU v3",
	"type": "module",
	"main": "./source/index.ts",
	"exports": {
		".": {
			"types": "./source/index.ts",
			"default": "./source/index.ts"
		},
		"./*": {
			"types": "./source/*.ts",
			"default": "./source/*.ts"
		}
	},
	"scripts": {
		"build": "bun ../../scripts/build.ts gravity-prisma",
		"dev": "bun --watch test/index.ts",
		"test": "bun test/index.ts",
		"generate": "prisma generate"
	},
	"dependencies": {
		"@digitak/gravity": "workspace:*"
	},
	"peerDependencies": {
		"@prisma/client": "^3",
		"prisma": "^3"
	},
	"devDependencies": {
		"@prisma/client": "3.14.0",
		"@types/fs-extra": "9.0.13",
		"dotenv": "14.3.2",
		"fs-extra": "10.1.0",
		"prisma": "3.14.0"
	},
	"prisma": {
		"schema": "test/prisma/schema.prisma"
	},
	"types": "./source/index.ts",
	"engines": {
		"bun": ">=1.4.4"
	}
}
