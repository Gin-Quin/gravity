{
	"name": "@digitak/gravity-svelte",
	"version": "0.9.69",
	"repository": "https://github.com/Gin-Quin/gravity",
	"author": "Gin Quin",
	"license": "GNU v3",
	"type": "module",
	"main": "./source/index.ts",
	"exports": {
		".": {
			"types": "./source/index.ts",
			"default": "./source/index.ts"
		},
		"./*": {
			"types": "./source/*.ts",
			"default": "./source/*.ts"
		}
	},
	"scripts": {
		"build": "bun ../../scripts/build.ts gravity-svelte"
	},
	"peerDependencies": {
		"@digitak/gravity": "workspace:*",
		"svelte": "^3 || ^4"
	},
	"devDependencies": {
		"@digitak/gravity": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "3.1.1",
		"@tsconfig/svelte": "2.0.1",
		"@types/fs-extra": "9.0.13",
		"svelte": "4.2.18",
		"svelte-check": "3.8.5",
		"svelte-preprocess": "6.0.2",
		"tslib": "2.6.3",
		"vite": "5.4.1"
	},
	"types": "./source/index.ts",
	"engines": {
		"bun": ">=1.4.4"
	}
}
