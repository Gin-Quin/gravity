{
	"name": "@digitak/gravity-svelte-kit",
	"version": "0.9.69",
	"author": "Gin Quin",
	"license": "GNU v3",
	"type": "module",
	"main": "./source/index.ts",
	"exports": {
		".": {
			"types": "./source/index.ts",
			"default": "./source/index.ts"
		},
		"./*": {
			"types": "./source/*.ts",
			"default": "./source/*.ts"
		}
	},
	"scripts": {
		"build": "bun ../../scripts/build.ts gravity-svelte-kit"
	},
	"dependencies": {
		"@digitak/gravity-svelte": "workspace:*"
	},
	"peerDependencies": {
		"@digitak/gravity": "workspace:*",
		"@sveltejs/kit": "^1 || ^2",
		"svelte": "^3 || ^4"
	},
	"devDependencies": {
		"@digitak/gravity": "workspace:*",
		"@sveltejs/adapter-auto": "3.2.4",
		"@sveltejs/kit": "2.5.22",
		"@types/fs-extra": "9.0.13",
		"eslint": "9.9.0",
		"fs-extra": "10.1.0",
		"prettier": "3.3.3",
		"prettier-plugin-svelte": "3.2.6",
		"svelte": "4.2.18",
		"svelte-check": "3.8.5",
		"svelte-preprocess": "6.0.2",
		"tslib": "2.6.3",
		"vite": "5.4.1",
		"@sveltejs/vite-plugin-svelte": "3.1.1"
	},
	"types": "./source/index.ts",
	"engines": {
		"bun": ">=1.4.4"
	}
}
