{
	"name": "test-2",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "GRAVITY_SCHEMALESS=true vite dev",
		"build": "bun check && bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"check": "bun check --no-script",
		"check:watch": "bunx --bun svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"svelte": "^4.2.7",
		"svelte-check": "^3.6.0",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.3"
	},
	"type": "module",
	"engines": {
		"bun": ">=1.4.4"
	}
}
