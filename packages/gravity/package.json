{
	"name": "@digitak/gravity",
	"version": "0.9.69",
	"description": "Next-generation backend framework with isomorphic capacities",
	"repository": "https://github.com/Gin-Quin/gravity",
	"author": "Gin Quin",
	"license": "GNU v3",
	"type": "module",
	"exports": {
		".": {
			"types": "./source/index.ts",
			"default": "./source/index.ts"
		},
		"./*": {
			"types": "./source/*.ts",
			"default": "./source/*.ts"
		}
	},
	"bin": "./source/cli/gravity.ts",
	"scripts": {
		"generate": "bun scripts/generate.ts",
		"dev": "bun test --watch test/rpc.test.ts",
		"build": "bun ../../scripts/build.ts gravity",
		"test": "bun test test/rpc.test.ts",
		"test:inspect": "bun test --inspect test/rpc.test.ts",
		"test:server": "bun run test:generate && bun test/server/index.ts",
		"test:server:inspect": "bun run test:generate && bun --inspect test/server/index.ts",
		"test:generate": "bun source/cli/gravity.ts generate schema",
		"test:guard": "bun test/guard.ts",
		"test:create": "bun source/cli/gravity.ts create",
		"test:build": "bun source/cli/gravity.ts build --minify false"
	},
	"dependencies": {
		"@digitak/bunker": "3.3.6",
		"@digitak/print": "1.1.4",
		"@ltd/j-toml": "1.30.0",
		"byte-base64": "1.1.0",
		"chalk": "5.0.1",
		"cli-select": "1.1.2",
		"fs-extra": "10.1.0",
		"idb-keyval": "6.1.0",
		"sade": "1.8.1",
		"typezer": "0.9.30"
	},
	"devDependencies": {
		"@types/fs-extra": "9.0.13"
	},
	"types": "./source/index.ts",
	"engines": {
		"bun": ">=1.4.4"
	}
}
